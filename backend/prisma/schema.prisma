generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OwnerUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id            String                 @id @default(uuid()) @db.Uuid
  name          String
  phone         String                 @unique
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  purchases     Purchase[]
  favoriteNotes CustomerFavoriteNote[]

  @@index([name])
}

model FragranceNote {
  id               String                 @id
  nameAr           String                 @unique
  sortOrder        Int                    @default(0)
  purchaseNotes    PurchaseNote[]
  primaryPurchases Purchase[]             @relation("PrimaryFragranceNote")
  customerFavorites CustomerFavoriteNote[]
}

model Purchase {
  id            String        @id @default(uuid()) @db.Uuid
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  perfumeName   String
  purchasedAt   DateTime      @db.Date
  rating        Int
  primaryNoteId String
  primaryNote   FragranceNote @relation("PrimaryFragranceNote", fields: [primaryNoteId], references: [id], onDelete: Restrict)
  notes         PurchaseNote[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId, purchasedAt])
  @@index([purchasedAt])
}

model PurchaseNote {
  purchaseId String        @db.Uuid
  noteId     String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  note       FragranceNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@id([purchaseId, noteId])
  @@index([noteId])
}

model CustomerFavoriteNote {
  customerId String        @db.Uuid
  noteId     String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note       FragranceNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@id([customerId, noteId])
  @@index([noteId])
}
